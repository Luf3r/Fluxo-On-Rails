RAILS_ENV=development
RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=debug

APP_HOST=localhost
APP_PORT=3000
APP_URL=http://localhost:3000

# Neon Serverless Postgres
# Use a pooled Neon connection string for Rails development/runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/fluxo?sslmode=require

# Use a fresh isolated Neon database or branch for local specs. Never point
# tests at the development, production, or previous Prisma database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-example-test-pooler.us-east-1.aws.neon.tech/fluxo_test?sslmode=require

# Keep a direct Neon URL available for migrations/release commands if your
# deploy platform or migration workflow should avoid a pooled connection.
NEON_DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/fluxo?sslmode=require

SMTP_ADDRESS=localhost
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025

# Active Storage uses disk services in development and test.
ACTIVE_STORAGE_SERVICE=local

# Production also uses DATABASE_URL. Solid Cache/Queue/Cable can share it, or
# use dedicated Neon URLs if separate databases are provisioned.
# CACHE_DATABASE_URL=${DATABASE_URL}
# QUEUE_DATABASE_URL=${DATABASE_URL}
# CABLE_DATABASE_URL=${DATABASE_URL}
