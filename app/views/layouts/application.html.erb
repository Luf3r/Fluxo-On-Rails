<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/site.webmanifest">

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-[#f7f8f6] text-zinc-950 antialiased">
    <div class="flex min-h-dvh flex-col">
      <header class="sticky top-0 z-20 border-b border-zinc-200/80 bg-[#f7f8f6]/90 backdrop-blur">
        <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8" aria-label="<%= t("app.nav.aria_label") %>">
          <%= link_to root_path, class: "flex items-center gap-3" do %>
            <span class="grid size-9 place-items-center">
              <%= image_tag "/fluxo.png", alt: "", class: "size-7 object-contain" %>
            </span>
            <span class="text-base font-semibold tracking-tight"><%= t("app.name") %></span>
          <% end %>

          <div class="hidden items-center gap-2 sm:flex">
            <div class="flex items-center gap-1 rounded-full border border-zinc-200 bg-white/70 p-1 text-xs font-bold text-zinc-500">
              <%= link_to "PT", url_for(locale: :"pt-BR"), class: "rounded-full px-2 py-1 transition #{I18n.locale == :"pt-BR" ? "bg-zinc-950 text-white" : "hover:text-zinc-950"}" %>
              <%= link_to "EN", url_for(locale: nil), class: "rounded-full px-2 py-1 transition #{I18n.locale == :en ? "bg-zinc-950 text-white" : "hover:text-zinc-950"}" %>
            </div>

            <% if user_signed_in? %>
              <span class="hidden max-w-56 truncate text-sm text-zinc-600 lg:inline"><%= t("app.nav.greeting", name: current_user.name.presence || current_user.email) %></span>
              <%= link_to t("app.nav.accounts"), accounts_path, class: "rounded-full px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-950" %>
              <%= link_to t("app.nav.categories"), categories_path, class: "rounded-full px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-950" %>
              <%= link_to t("app.nav.transactions"), transactions_path, class: "rounded-full px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-950" %>
              <%= link_to t("app.nav.account"), edit_user_registration_path, class: "rounded-full px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-950" %>
              <%= button_to t("app.nav.sign_out"), destroy_user_session_path, method: :delete, class: "rounded-full border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-800 transition hover:border-zinc-950 hover:bg-white" %>
            <% else %>
              <%= link_to t("app.nav.sign_in"), new_user_session_path, class: "rounded-full px-4 py-2 text-sm font-medium text-zinc-700 transition hover:bg-white hover:text-zinc-950" %>
              <%= link_to t("app.nav.sign_up"), new_user_registration_path, class: "rounded-full bg-zinc-950 px-4 py-2 text-sm font-semibold text-white shadow-sm shadow-zinc-950/10 transition hover:bg-emerald-700" %>
            <% end %>
          </div>

          <div class="flex items-center gap-2 sm:!hidden">
            <div class="flex items-center gap-1 rounded-full border border-zinc-200 bg-white/80 p-1 text-xs font-bold text-zinc-500 shadow-sm shadow-zinc-950/5" aria-label="<%= t("app.nav.language") %>">
              <%= link_to "PT", url_for(locale: :"pt-BR"), class: "rounded-full px-2.5 py-1 transition #{I18n.locale == :"pt-BR" ? "bg-zinc-950 text-white" : "hover:text-zinc-950"}" %>
              <%= link_to "EN", url_for(locale: nil), class: "rounded-full px-2.5 py-1 transition #{I18n.locale == :en ? "bg-zinc-950 text-white" : "hover:text-zinc-950"}" %>
            </div>

            <details class="group relative">
              <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-zinc-200 bg-white text-zinc-950 shadow-sm shadow-zinc-950/5 transition hover:border-zinc-300 group-open:bg-zinc-950 group-open:text-white [&::-webkit-details-marker]:hidden" aria-label="<%= t("app.nav.mobile_menu") %>">
                <span class="flex w-4 flex-col gap-1">
                  <span class="h-0.5 rounded-full bg-current"></span>
                  <span class="h-0.5 rounded-full bg-current"></span>
                  <span class="h-0.5 rounded-full bg-current"></span>
                </span>
              </summary>

              <div class="absolute right-0 top-12 w-[min(20rem,calc(100vw-2.5rem))] overflow-hidden rounded-3xl border border-zinc-200 bg-white p-2 text-sm shadow-2xl shadow-zinc-950/15">
                <% if user_signed_in? %>
                  <p class="px-4 py-3 text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("app.nav.greeting", name: current_user.name.presence || current_user.email) %></p>
                  <%= link_to t("app.nav.accounts"), accounts_path, class: "block rounded-2xl px-4 py-3 font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                  <%= link_to t("app.nav.categories"), categories_path, class: "block rounded-2xl px-4 py-3 font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                  <%= link_to t("app.nav.transactions"), transactions_path, class: "block rounded-2xl px-4 py-3 font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                  <%= link_to t("app.nav.account"), edit_user_registration_path, class: "block rounded-2xl px-4 py-3 font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                  <%= button_to t("app.nav.sign_out"), destroy_user_session_path, method: :delete, class: "w-full rounded-2xl px-4 py-3 text-left font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                <% else %>
                  <%= link_to t("app.nav.sign_in"), new_user_session_path, class: "block rounded-2xl px-4 py-3 font-semibold text-zinc-800 transition hover:bg-zinc-100 hover:text-zinc-950" %>
                  <%= link_to t("app.nav.sign_up"), new_user_registration_path, class: "mt-1 block rounded-2xl bg-zinc-950 px-4 py-3 text-center font-bold text-white transition hover:bg-emerald-700" %>
                <% end %>
              </div>
            </details>
          </div>
        </nav>
      </header>

      <main class="flex-1">
        <div class="mx-auto max-w-7xl px-5 lg:px-8">
          <% if notice.present? %>
            <p class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900"><%= notice %></p>
          <% end %>
          <% if alert.present? %>
            <p class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900"><%= alert %></p>
          <% end %>
        </div>
        <%= yield %>
      </main>

      <footer id="rodape" class="bg-zinc-950 text-white">
        <div class="mx-auto max-w-7xl px-5 py-10 lg:px-8 lg:py-12">
          <div class="grid gap-8 border-t border-white/10 pt-8 md:grid-cols-[1.25fr_0.75fr_0.75fr]">
            <div class="max-w-xl">
              <%= link_to root_path, class: "inline-flex items-center gap-3" do %>
                <span class="grid size-10 place-items-center">
                  <%= image_tag "/fluxo.png", alt: "", class: "size-8 object-contain" %>
                </span>
                <span class="text-lg font-black tracking-tight"><%= t("app.name") %></span>
              <% end %>
              <p class="mt-5 text-base font-semibold leading-7 text-white"><%= t("app.footer.line_one") %></p>
              <p class="mt-3 max-w-md text-sm leading-6 text-zinc-400"><%= t("app.footer.line_two") %></p>
            </div>

            <div>
              <h2 class="text-sm font-bold text-white"><%= t("app.footer.product") %></h2>
              <nav class="mt-4 grid gap-3 text-sm text-zinc-400" aria-label="<%= t("app.footer.product") %>">
                <%= link_to t("app.footer.home"), root_path, class: "transition hover:text-white" %>
                <%= link_to t("app.footer.how_it_works"), root_path(anchor: "como-funciona"), class: "transition hover:text-white" %>
                <%= link_to t("app.footer.planning"), root_path(anchor: "planejamento"), class: "transition hover:text-white" %>
              </nav>
            </div>

            <div>
              <h2 class="text-sm font-bold text-white"><%= t("app.footer.account") %></h2>
              <div class="mt-4 grid gap-3 text-sm text-zinc-400">
                <% if user_signed_in? %>
                  <%= link_to t("app.nav.account"), edit_user_registration_path, class: "transition hover:text-white" %>
                  <%= button_to t("app.nav.sign_out"), destroy_user_session_path, method: :delete, class: "text-left transition hover:text-white" %>
                <% else %>
                  <%= link_to t("app.nav.sign_in"), new_user_session_path, class: "transition hover:text-white" %>
                  <%= link_to t("app.nav.sign_up"), new_user_registration_path, class: "transition hover:text-white" %>
                <% end %>
              </div>

              <div class="mt-6">
                <p class="text-sm font-bold text-white"><%= t("app.footer.language") %></p>
                <div class="mt-3 inline-flex items-center gap-1 rounded-full border border-white/15 bg-white/10 p-1 text-xs font-bold text-zinc-300">
                  <%= link_to "PT", url_for(locale: :"pt-BR"), class: "rounded-full px-2.5 py-1 transition #{I18n.locale == :"pt-BR" ? "bg-white text-zinc-950" : "hover:text-white"}" %>
                  <%= link_to "EN", url_for(locale: nil), class: "rounded-full px-2.5 py-1 transition #{I18n.locale == :en ? "bg-white text-zinc-950" : "hover:text-white"}" %>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs leading-5 text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
            <p><%= t("app.footer.copyright", year: Time.current.year) %></p>
            <p><%= t("app.footer.status") %></p>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
