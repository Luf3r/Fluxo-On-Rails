<% content_for :title, @transaction.description.presence || t("finance.transactions.untitled") %>

<section class="mx-auto max-w-3xl px-5 py-10 lg:px-8">
  <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm shadow-zinc-950/5">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("finance.transactions.show.eyebrow") %></p>
    <h1 class="mt-2 text-3xl font-black tracking-tight text-zinc-950"><%= @transaction.description.presence || t("finance.transactions.untitled") %></h1>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.table.amount") %></dt>
        <dd class="mt-1 text-2xl font-black text-zinc-950"><%= finance_money(@transaction.amount, @transaction.account.currency) %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.table.account") %></dt>
        <dd class="mt-1 font-semibold text-zinc-900"><%= @transaction.account.name %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.table.date") %></dt>
        <dd class="mt-1 font-semibold text-zinc-900"><%= l(@transaction.date) %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.fields.type") %></dt>
        <dd class="mt-1 font-semibold text-zinc-900"><%= t("finance.transactions.types.#{@transaction.transaction_type}") %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.fields.category") %></dt>
        <dd class="mt-1 font-semibold text-zinc-900"><%= @transaction.category&.display_name || t("finance.transactions.show.no_category") %></dd>
      </div>
      <div>
        <dt class="text-xs font-bold uppercase tracking-wide text-zinc-500"><%= t("finance.transactions.fields.tags") %></dt>
        <dd class="mt-1 font-semibold text-zinc-900"><%= @transaction.tags.any? ? @transaction.tags.order(:name).pluck(:name).join(", ") : t("finance.transactions.show.no_tags") %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to t("finance.actions.edit"), edit_transaction_path(@transaction), class: "rounded-full bg-zinc-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-700" %>
      <%= link_to t("finance.actions.back"), transactions_path, class: "rounded-full border border-zinc-300 px-5 py-3 text-sm font-bold text-zinc-800 transition hover:border-zinc-950" %>
    </div>
  </article>
</section>
