<div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm shadow-zinc-950/5">
  <h1 class="text-3xl font-black tracking-tight text-zinc-950"><%= title %></h1>

  <%= render "devise/shared/error_messages", resource: category %>

  <%= form_with model: category, class: "mt-6 grid gap-5" do |form| %>
    <%= hidden_field_tag :locale, I18n.locale if I18n.locale != I18n.default_locale %>

    <div>
      <%= form.label :name, t("finance.categories.fields.name"), class: "text-sm font-bold text-zinc-800" %>
      <%= form.text_field :name, class: "mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-700" %>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :category_type, t("finance.categories.fields.type"), class: "text-sm font-bold text-zinc-800" %>
        <%= form.select :category_type, Category::CATEGORY_TYPES.map { |type| [t("finance.categories.types.#{type}"), type] }, {}, class: "mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-700" %>
      </div>
      <div>
        <%= form.label :parent_id, t("finance.categories.fields.parent"), class: "text-sm font-bold text-zinc-800" %>
        <%= form.collection_select :parent_id, @parent_categories, :id, :display_name, { include_blank: t("finance.categories.form.no_parent") }, class: "mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-700" %>
      </div>
    </div>

    <div>
      <%= form.label :budget_amount, t("finance.categories.fields.budget_amount"), class: "text-sm font-bold text-zinc-800" %>
      <%= form.number_field :budget_amount, step: "0.01", min: "0", class: "mt-2 w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-700" %>
      <p class="mt-2 text-sm text-zinc-500"><%= t("finance.categories.form.budget_hint") %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= form.submit submit_label, class: "rounded-full bg-zinc-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-700" %>
      <%= link_to t("finance.actions.cancel"), categories_path, class: "rounded-full border border-zinc-300 px-5 py-3 text-sm font-bold text-zinc-800 transition hover:border-zinc-950" %>
    </div>
  <% end %>
</div>
