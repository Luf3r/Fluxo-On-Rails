<% content_for :title, t("finance.categories.index.title") %>

<section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
  <div class="flex flex-col gap-5 border-b border-zinc-200 pb-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("finance.categories.index.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-zinc-950"><%= t("finance.categories.index.heading") %></h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-zinc-600"><%= t("finance.categories.index.body") %></p>
    </div>
    <%= link_to t("finance.categories.index.new"), new_category_path, class: "inline-flex items-center justify-center rounded-full bg-zinc-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-700" %>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_0.85fr]">
    <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm shadow-zinc-950/5">
      <div class="border-b border-zinc-200 bg-zinc-50 px-5 py-4">
        <h2 class="text-sm font-black uppercase tracking-wide text-zinc-600"><%= t("finance.categories.index.custom") %></h2>
      </div>

      <div class="divide-y divide-zinc-100">
        <% @custom_categories.each do |category| %>
          <article class="grid gap-3 px-5 py-4 md:grid-cols-[1fr_0.45fr_0.45fr_auto] md:items-center">
            <div>
              <h3 class="font-bold text-zinc-950"><%= category.display_name %></h3>
              <p class="mt-1 text-sm text-zinc-500">
                <%= t("finance.categories.types.#{category.category_type}") %>
                <% if category.parent.present? %>
                  · <%= t("finance.categories.index.child_of", parent: category.parent.display_name) %>
                <% end %>
              </p>
            </div>
            <p class="text-sm font-semibold text-zinc-700"><%= category.budget_amount.present? ? finance_money(category.budget_amount, current_user.currency) : t("finance.categories.index.no_budget") %></p>
            <p class="text-sm text-zinc-600"><%= pluralize(category.transactions.count, t("finance.categories.index.transaction")) %></p>
            <div class="flex flex-wrap gap-2 md:justify-end">
              <%= link_to t("finance.actions.edit"), edit_category_path(category), class: "rounded-full border border-zinc-200 px-3 py-2 text-xs font-bold text-zinc-700 transition hover:border-zinc-950" %>
              <%= button_to t("finance.actions.destroy"), category_path(category), method: :delete, class: "rounded-full border border-red-200 px-3 py-2 text-xs font-bold text-red-700 transition hover:border-red-700 hover:bg-red-50" %>
            </div>
          </article>
        <% end %>

        <% if @custom_categories.empty? %>
          <p class="px-5 py-10 text-center text-sm text-zinc-500"><%= t("finance.categories.index.empty") %></p>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/5">
      <h2 class="text-sm font-black uppercase tracking-wide text-zinc-600"><%= t("finance.categories.index.system") %></h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <% @system_categories.each do |category| %>
          <span class="rounded-full border border-zinc-200 bg-zinc-50 px-3 py-2 text-xs font-bold text-zinc-700"><%= category.display_name %> · <%= t("finance.categories.types.#{category.category_type}") %></span>
        <% end %>
      </div>
    </div>
  </div>
</section>
