<% content_for :title, t("auth.registration.title") %>

<section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-20">
  <div class="flex flex-col justify-center">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t("auth.registration.eyebrow") %></p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-zinc-950 sm:text-5xl"><%= t("auth.registration.headline") %></h1>
    <p class="mt-5 max-w-xl text-lg leading-8 text-zinc-600">
      <%= t("auth.registration.body") %>
    </p>

    <div class="mt-8 rounded-3xl border border-zinc-200 bg-white p-5">
      <p class="text-sm font-bold text-zinc-950"><%= t("auth.registration.ready_title") %></p>
      <ul class="mt-4 space-y-3 text-sm leading-6 text-zinc-600">
        <li class="flex gap-3"><span class="mt-2 size-2 rounded-full bg-emerald-600"></span><%= t("auth.registration.ready_items.account") %></li>
        <li class="flex gap-3"><span class="mt-2 size-2 rounded-full bg-emerald-600"></span><%= t("auth.registration.ready_items.currency") %></li>
        <li class="flex gap-3"><span class="mt-2 size-2 rounded-full bg-emerald-600"></span><%= t("auth.registration.ready_items.goals") %></li>
      </ul>
    </div>
  </div>

  <div class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-2xl shadow-zinc-900/10 sm:p-8">
    <div class="mb-8">
      <h2 class="text-2xl font-black tracking-tight text-zinc-950"><%= t("auth.registration.form_title") %></h2>
      <p class="mt-2 text-sm text-zinc-600"><%= t("auth.registration.form_hint", count: @minimum_password_length || 6) %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, t("auth.registration.fields.name"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition placeholder:text-zinc-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div>
        <%= f.label :email, t("auth.registration.fields.email"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.email_field :email, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition placeholder:text-zinc-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div>
        <%= f.label :currency, t("auth.registration.fields.currency"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.select :currency, options_for_select([ "BRL", "USD", "EUR" ], resource.currency.presence || "BRL"), {}, class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :password, t("auth.registration.fields.password"), class: "block text-sm font-bold text-zinc-800" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
        </div>

        <div>
          <%= f.label :password_confirmation, t("auth.registration.fields.password_confirmation"), class: "block text-sm font-bold text-zinc-800" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
        </div>
      </div>

      <%= f.submit t("auth.registration.submit"), class: "w-full cursor-pointer rounded-full bg-zinc-950 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-950/10 transition hover:bg-emerald-700" %>
    <% end %>

    <div class="mt-6 border-t border-zinc-200 pt-6 text-sm text-zinc-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
