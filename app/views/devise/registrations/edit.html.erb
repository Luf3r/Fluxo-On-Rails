<% content_for :title, t("auth.account.title") %>

<section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-[0.9fr_1.1fr] lg:px-8 lg:py-20">
  <div class="flex flex-col justify-center">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t("auth.account.eyebrow") %></p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-zinc-950 sm:text-5xl"><%= t("auth.account.headline") %></h1>
    <p class="mt-5 max-w-xl text-lg leading-8 text-zinc-600">
      <%= t("auth.account.body") %>
    </p>

    <div class="mt-8 rounded-3xl border border-zinc-200 bg-white p-5">
      <p class="text-sm font-bold text-zinc-950"><%= t("auth.account.status_title") %></p>
      <dl class="mt-4 space-y-3 text-sm leading-6 text-zinc-600">
        <div class="flex items-center justify-between gap-4">
          <dt><%= t("auth.account.status.email") %></dt>
          <dd class="font-semibold text-zinc-950"><%= resource.email %></dd>
        </div>
        <div class="flex items-center justify-between gap-4">
          <dt><%= t("auth.account.status.confirmation") %></dt>
          <dd class="font-semibold <%= resource.confirmed? ? "text-emerald-700" : "text-amber-700" %>">
            <%= resource.confirmed? ? t("auth.account.status.confirmed") : t("auth.account.status.pending") %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-2xl shadow-zinc-900/10 sm:p-8">
    <div class="mb-8">
      <h2 class="text-2xl font-black tracking-tight text-zinc-950"><%= t("auth.account.form_title") %></h2>
      <p class="mt-2 text-sm text-zinc-600"><%= t("auth.account.form_hint") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, t("auth.account.fields.name"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition placeholder:text-zinc-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div>
        <%= f.label :email, t("auth.account.fields.email"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.email_field :email, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition placeholder:text-zinc-400 focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div>
        <%= f.label :currency, t("auth.account.fields.currency"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.select :currency, options_for_select(User::SUPPORTED_CURRENCIES, resource.currency.presence || "BRL"), {}, class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :password, t("auth.account.fields.password"), class: "block text-sm font-bold text-zinc-800" %>
          <p class="mt-1 text-xs text-zinc-500"><%= t("auth.account.fields.password_hint") %></p>
          <%= f.password_field :password, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
        </div>

        <div>
          <%= f.label :password_confirmation, t("auth.account.fields.password_confirmation"), class: "block text-sm font-bold text-zinc-800" %>
          <p class="mt-1 text-xs text-zinc-500"><%= t("auth.account.fields.password_confirmation_hint") %></p>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
        </div>
      </div>

      <div>
        <%= f.label :current_password, t("auth.account.fields.current_password"), class: "block text-sm font-bold text-zinc-800" %>
        <p class="mt-1 text-xs text-zinc-500"><%= t("auth.account.fields.current_password_hint") %></p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <%= f.submit t("auth.account.submit"), class: "w-full cursor-pointer rounded-full bg-zinc-950 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-950/10 transition hover:bg-emerald-700" %>
    <% end %>
  </div>
</section>
