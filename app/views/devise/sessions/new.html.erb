<% content_for :title, t("auth.session.title") %>

<section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-[0.95fr_1.05fr] lg:px-8 lg:py-20">
  <div class="flex flex-col justify-center">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t("auth.session.eyebrow") %></p>
    <h1 class="mt-4 text-4xl font-black tracking-tight text-zinc-950 sm:text-5xl"><%= t("auth.session.headline") %></h1>
    <p class="mt-5 max-w-xl text-lg leading-8 text-zinc-600">
      <%= t("auth.session.body") %>
    </p>
  </div>

  <div class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-2xl shadow-zinc-900/10 sm:p-8">
    <div class="mb-8">
      <h2 class="text-2xl font-black tracking-tight text-zinc-950"><%= t("auth.session.form_title") %></h2>
      <p class="mt-2 text-sm text-zinc-600"><%= t("auth.session.form_hint") %></p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, t("auth.session.fields.email"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <div>
        <%= f.label :password, t("auth.session.fields.password"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-3 text-sm font-medium text-zinc-700">
          <%= f.check_box :remember_me, class: "size-4 rounded border-zinc-300 text-emerald-700 focus:ring-emerald-600" %>
          <%= t("auth.session.fields.remember_me") %>
        </label>
      <% end %>

      <%= f.submit t("auth.session.submit"), class: "w-full cursor-pointer rounded-full bg-zinc-950 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-950/10 transition hover:bg-emerald-700" %>
    <% end %>

    <div class="mt-6 border-t border-zinc-200 pt-6 text-sm text-zinc-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
