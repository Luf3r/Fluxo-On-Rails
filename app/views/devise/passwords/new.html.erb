<% content_for :title, t("auth.passwords.new.title") %>

<section class="mx-auto max-w-xl px-5 py-14 lg:px-8 lg:py-20">
  <div class="rounded-[2rem] border border-zinc-200 bg-white p-6 shadow-2xl shadow-zinc-900/10 sm:p-8">
    <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t("auth.passwords.new.eyebrow") %></p>
    <h1 class="mt-4 text-3xl font-black tracking-tight text-zinc-950"><%= t("auth.passwords.new.headline") %></h1>
    <p class="mt-3 leading-7 text-zinc-600"><%= t("auth.passwords.new.body") %></p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, t("auth.passwords.new.email"), class: "block text-sm font-bold text-zinc-800" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-2 block w-full rounded-2xl border border-zinc-300 bg-white px-4 py-3 text-zinc-950 outline-none transition focus:border-emerald-600 focus:ring-4 focus:ring-emerald-100" %>
      </div>

      <%= f.submit t("auth.passwords.new.submit"), class: "w-full cursor-pointer rounded-full bg-zinc-950 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-950/10 transition hover:bg-emerald-700" %>
    <% end %>

    <div class="mt-6 border-t border-zinc-200 pt-6 text-sm text-zinc-600">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</section>
