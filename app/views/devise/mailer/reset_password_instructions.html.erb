<p><%= t("auth.mailer.reset_password.greeting", name: @resource.name.presence || @resource.email) %></p>

<p><%= t("auth.mailer.reset_password.body") %></p>

<p><%= link_to t("auth.mailer.reset_password.cta"), edit_password_url(@resource, reset_password_token: @token) %></p>

<p><%= t("auth.mailer.reset_password.ignore") %></p>
<p><%= t("auth.mailer.reset_password.no_change") %></p>
