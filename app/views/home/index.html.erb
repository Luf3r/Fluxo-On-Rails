<% content_for :title, t("home.title") %>

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:py-20 lg:grid-cols-[1.02fr_0.98fr] lg:px-8 lg:py-24">
    <div class="flex flex-col justify-center">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-emerald-700"><%= t("home.hero.eyebrow") %></p>
      <h1 class="mt-5 max-w-3xl text-5xl font-black leading-[0.98] tracking-tight text-zinc-950 sm:text-6xl lg:text-7xl">
        <%= t("home.hero.headline") %>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600">
        <%= t("home.hero.body") %>
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <%= link_to t("home.hero.primary_cta"), new_user_registration_path, class: "inline-flex items-center justify-center rounded-full bg-zinc-950 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-zinc-950/10 transition hover:bg-emerald-700" %>
        <%= link_to t("home.hero.secondary_cta"), new_user_session_path, class: "inline-flex items-center justify-center rounded-full border border-zinc-300 bg-white/70 px-6 py-3 text-sm font-bold text-zinc-900 transition hover:border-zinc-950 hover:bg-white" %>
      </div>

      <dl class="mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-zinc-200 pt-6">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.hero.stats.first_label") %></dt>
          <dd class="mt-1 text-2xl font-black text-zinc-950"><%= t("home.hero.stats.first_value") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.hero.stats.second_label") %></dt>
          <dd class="mt-1 text-2xl font-black text-zinc-950"><%= t("home.hero.stats.second_value") %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.hero.stats.third_label") %></dt>
          <dd class="mt-1 text-2xl font-black text-zinc-950"><%= t("home.hero.stats.third_value") %></dd>
        </div>
      </dl>
    </div>

    <div class="relative lg:pt-8">
      <div class="absolute -left-5 top-16 h-44 w-44 rounded-full bg-emerald-200/50 blur-3xl"></div>
      <div class="relative rounded-[2rem] border border-zinc-200 bg-white p-4 shadow-2xl shadow-zinc-900/10">
        <div class="rounded-[1.5rem] border border-zinc-200 bg-[#fbfcfa] p-5">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-zinc-500"><%= t("home.mockup.projected_balance") %></p>
              <p class="mt-1 text-4xl font-black tracking-tight text-zinc-950"><%= t("home.mockup.projected_balance_value") %></p>
            </div>
            <span class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-bold text-emerald-800">+12%</span>
          </div>

          <div class="mt-8 rounded-3xl border border-emerald-100 bg-gradient-to-b from-emerald-50 to-white p-5">
            <div class="flex items-end justify-between gap-3">
              <% %w[h-[38px] h-[58px] h-[46px] h-[72px] h-[64px] h-[88px] h-[78px]].each_with_index do |height_class, index| %>
                <div class="flex flex-1 flex-col items-center gap-3">
                  <div class="w-full rounded-t-xl bg-emerald-600/90 <%= height_class %>"></div>
                  <span class="text-xs font-semibold text-zinc-500"><%= %w[J F M A M J J][index] %></span>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mt-5 grid gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-zinc-200 bg-white p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.mockup.housing") %></p>
              <p class="mt-2 text-2xl font-black text-zinc-950">32%</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 bg-white p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.mockup.groceries") %></p>
              <p class="mt-2 text-2xl font-black text-zinc-950">18%</p>
            </div>
            <div class="rounded-2xl border border-zinc-200 bg-white p-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500"><%= t("home.mockup.goals") %></p>
              <p class="mt-2 text-2xl font-black text-zinc-950">24%</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="como-funciona" class="border-y border-zinc-200 bg-white">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-14 md:grid-cols-3 lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("home.routine.eyebrow") %></p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-zinc-950"><%= t("home.routine.headline") %></h2>
    </div>
    <div class="rounded-3xl border border-zinc-200 bg-[#f7f8f6] p-6">
      <h3 class="text-lg font-bold text-zinc-950"><%= t("home.routine.month_title") %></h3>
      <p class="mt-3 leading-7 text-zinc-600"><%= t("home.routine.month_body") %></p>
    </div>
    <div class="rounded-3xl border border-zinc-200 bg-[#f7f8f6] p-6">
      <h3 class="text-lg font-bold text-zinc-950"><%= t("home.routine.plan_title") %></h3>
      <p class="mt-3 leading-7 text-zinc-600"><%= t("home.routine.plan_body") %></p>
    </div>
  </div>
</section>

<section id="planejamento" class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
  <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("home.planning.eyebrow") %></p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-zinc-950"><%= t("home.planning.headline") %></h2>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <% %w[balance categories goals budget].each do |key| %>
        <article class="rounded-3xl border border-zinc-200 bg-white p-6">
          <h3 class="font-bold text-zinc-950"><%= t("home.planning.items.#{key}.title") %></h3>
          <p class="mt-3 leading-7 text-zinc-600"><%= t("home.planning.items.#{key}.body") %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="bg-zinc-950">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 text-white lg:grid-cols-[1fr_0.8fr] lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-300"><%= t("home.close.eyebrow") %></p>
      <h2 class="mt-4 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl"><%= t("home.close.headline") %></h2>
    </div>
    <div class="flex flex-col justify-center">
      <p class="text-lg leading-8 text-zinc-300">
        <%= t("home.close.body") %>
      </p>
      <div class="mt-8">
        <%= link_to t("home.close.cta"), new_user_registration_path, class: "inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-zinc-950 transition hover:bg-emerald-100" %>
      </div>
    </div>
  </div>
</section>
