<% content_for :title, t("finance.accounts.index.title") %>

<section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
  <div class="flex flex-col gap-5 border-b border-zinc-200 pb-6 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-emerald-700"><%= t("finance.accounts.index.eyebrow") %></p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-zinc-950"><%= t("finance.accounts.index.heading") %></h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-zinc-600"><%= t("finance.accounts.index.body") %></p>
    </div>
    <%= link_to t("finance.accounts.index.new"), new_account_path, class: "inline-flex items-center justify-center rounded-full bg-zinc-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-700" %>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @accounts.each do |account| %>
      <% balance = account.current_balance %>
      <article class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm shadow-zinc-950/5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-black text-zinc-950"><%= link_to account.name, account_path(account), class: "hover:text-emerald-700" %></h2>
            <p class="mt-1 text-sm font-semibold text-zinc-500"><%= t("finance.accounts.types.#{account.account_type}") %> · <%= account.currency %></p>
          </div>
          <span class="rounded-full px-3 py-1 text-xs font-bold <%= balance.negative? ? "bg-red-50 text-red-700" : "bg-emerald-50 text-emerald-800" %>"><%= finance_money(balance, account.currency) %></span>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <%= link_to t("finance.actions.view"), account_path(account), class: "rounded-full border border-zinc-200 px-3 py-2 text-xs font-bold text-zinc-700 transition hover:border-zinc-950 hover:text-zinc-950" %>
          <%= link_to t("finance.actions.edit"), edit_account_path(account), class: "rounded-full border border-zinc-200 px-3 py-2 text-xs font-bold text-zinc-700 transition hover:border-zinc-950 hover:text-zinc-950" %>
        </div>
      </article>
    <% end %>
  </div>

  <% if @accounts.empty? %>
    <div class="mt-8 rounded-2xl border border-dashed border-zinc-300 bg-white p-8 text-center">
      <h2 class="text-xl font-black text-zinc-950"><%= t("finance.accounts.index.empty_title") %></h2>
      <p class="mt-2 text-sm leading-6 text-zinc-600"><%= t("finance.accounts.index.empty_body") %></p>
    </div>
  <% end %>
</section>
